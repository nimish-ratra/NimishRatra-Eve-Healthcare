# ==============================================================================
# EVE Healthcare Backend - Environment Configuration Template
# COPY THIS FILE TO .env AND ADAPT VALUES AS APPROPRIATE.
# NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL!
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-eve-healthcare-dev-environment-key-change-in-production-!#99x
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eve_healthcare_db
DB_USER=eve_user
DB_PASSWORD=eve_secure_password_dev
DB_HOST=localhost
DB_PORT=5432

# Fallback SQLite toggle for lightweight unit tests when PostgreSQL is unavailable
USE_SQLITE=False

# JWT Authentication Settings
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Payment Provider Simulation & Webhook Security
# Shared secret used to sign and verify HMAC-SHA256 signatures on POST /api/v1/payments/webhook/
WEBHOOK_SECRET=dev_shared_webhook_secret_key_eve_healthcare_2026
# Webhook timestamp freshness window in seconds (replay attack protection)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Redis Cache & Throttling (Optional supporting infrastructure)
REDIS_URL=redis://localhost:6379/1
USE_REDIS=False

# Throttling Rates
THROTTLE_ANON_BURST=30/min
THROTTLE_USER_BURST=120/min
THROTTLE_AUTH_RATE=5/min
THROTTLE_WEBHOOK_RATE=60/min
